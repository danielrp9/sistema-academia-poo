# ==============================================================================
# SISTEMA DE GESTÃO DE ACADEMIA - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academiadb
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password_123
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Configurações de Segurança e JWT (Gere uma chave secreta forte de 256 bits)
JWT_SECRET=super_secret_jwt_key_academia_milho_verde_2026_production_safe_token_key
JWT_EXPIRATION_HOURS=8

# Configuração de CORS (URLs permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Porta do Servidor Backend
SERVER_PORT=8080

# Perfil do Spring (dev para H2 em memória, prod para PostgreSQL via Docker)
SPRING_PROFILES_ACTIVE=dev
